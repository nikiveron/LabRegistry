<Window x:Class="LabRegistry.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реестр объектов проверки"
        Height="750"
        Width="1200"
        MinHeight="650"
        MinWidth="1000">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Индикатор загрузки -->
        <ProgressBar Grid.Row="0"
                 Height="4"
                 Margin="0,0,0,10"
                 IsIndeterminate="True"
                 Visibility="{Binding IsLoading,
                              Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Заголовок -->
        <TextBlock Grid.Row="1"
                   Text="Реестр объектов проверки"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Фильтры -->
        <Border Grid.Row="2"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,10,0">

                    <TextBlock Text="Поиск по наименованию"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,10,0">

                    <TextBlock Text="Тип"
                               Margin="0,0,0,5"/>

                    <ComboBox ItemsSource="{Binding GetProductTypes}"
                              SelectedItem="{Binding SelectedProductType}"
                              Height="30"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="0,0,10,0">

                    <TextBlock Text="Результат"
                               Margin="0,0,0,5"/>

                    <ComboBox ItemsSource="{Binding GetProductResults}"
                              SelectedItem="{Binding SelectedProductResult}"
                              Height="30"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="Найти"
                        Command="{Binding LoadCommand}"
                        Height="30"
                        Margin="0,20,10,0"/>

                <Button Grid.Column="4"
                        Content="Сбросить"
                        Command="{Binding ClearFiltersCommand}"
                        Height="30"
                        Margin="0,20,0,0"/>

            </Grid>
        </Border>

        <!-- Сообщения -->
        <StackPanel Grid.Row="3"
                    Margin="0,0,0,10">

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasError,
                            Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Text="{Binding SuccessMessage}"
                       Foreground="Green"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasSuccess,
                            Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Objects}"
                  SelectedItem="{Binding SelectedObject}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Margin="0,0,0,15">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Наименование"
                                    Binding="{Binding Name}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Версия"
                                    Binding="{Binding Version}"
                                    Width="100"/>

                <DataGridTextColumn Header="Тип"
                                    Binding="{Binding ProductType}"
                                    Width="100"/>

                <DataGridTextColumn Header="Дата поступления"
                                    Binding="{Binding ReceiptDate,
                                              StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="150"/>

                <DataGridTextColumn Header="Результат"
                                    Binding="{Binding ProductResult}"
                                    Width="170"/>

                <DataGridTextColumn Header="Примечание"
                                    Binding="{Binding Comment}"
                                    Width="2*"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Пагинация -->
        <StackPanel Grid.Row="5"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,10">

            <Button Content="← Назад"
            Command="{Binding PreviousPageCommand}"
            Width="100"
            Margin="0,0,10,0"/>

            <TextBlock VerticalAlignment="Center"
               Margin="0,0,10,0">

                <Run Text="Страница "/>
                <Run Text="{Binding CurrentPage}"/>
                <Run Text=" из "/>
                <Run Text="{Binding TotalPages}"/>

            </TextBlock>

            <Button Content="Вперёд →"
            Command="{Binding NextPageCommand}"
            Width="100"/>
        </StackPanel>

        <!-- Нижняя часть -->
        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Добавление -->
            <GroupBox Grid.Column="0"
                      Header="Добавить объект"
                      Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Наименование:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,10"/>

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Text="{Binding NewName,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200"
                             Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Версия:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,10"/>

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding NewVersion,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Тип:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,10"/>

                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              ItemsSource="{Binding CreateProductTypes}"
                              SelectedItem="{Binding NewProductType}"
                              Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Дата поступления:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,10"/>

                    <DatePicker Grid.Row="3"
                                Grid.Column="1"
                                SelectedDate="{Binding ReceiptDate}"
                                Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Время поступления:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,10"/>

                    <ComboBox Grid.Row="4"
                              Grid.Column="1"
                              SelectedItem="{Binding ReceiptTime}"
                              ItemsSource="{Binding TimeOptions}"
                              Margin="0,0,0,10">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=hh\\:mm}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>

                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="Примечание:"
                               VerticalAlignment="Top"
                               Margin="0,0,10,10"/>

                    <TextBox Grid.Row="5"
                             Grid.Column="1"
                             Text="{Binding NewComment,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="1000"
                             Margin="0,0,0,10"/>

                    <Button Grid.Row="6"
                            Grid.Column="1"
                            Content="Добавить"
                            Command="{Binding CreateCommand}"
                            Height="32"/>

                </Grid>

            </GroupBox>

            <!-- Редактирование -->
            <GroupBox Grid.Column="2"
                      Header="Результат проверки"
                      Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Выберите объект в таблице"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Grid.Row="1"
                               Text="Результат:"
                               Margin="0,0,0,5"/>

                    <ComboBox Grid.Row="2"
                              ItemsSource="{Binding UpdateProductResults}"
                              SelectedItem="{Binding EditProductResult}"
                              Margin="0,0,0,10"/>

                    <Grid Grid.Row="3">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Примечание:"
                                   Margin="0,0,0,5"/>

                        <TextBox Grid.Row="1"
                                 Text="{Binding EditComment,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxLength="1000"/>

                        <Button Grid.Row="2"
                                Content="Сохранить результат"
                                Command="{Binding UpdateCommand}"
                                Height="32"
                                Margin="0,10,0,0"/>

                    </Grid>

                </Grid>

            </GroupBox>

        </Grid>

    </Grid>

</Window>